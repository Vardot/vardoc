{
  "name": "vardot/vardoc",
  "description": "Vardoc: Knowledge Base System and Documentation Site",
  "type": "drupal-profile",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Vardot",
      "homepage": "https://www.drupal.org/vardot",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "http://drupal.org/project/issues/vardoc",
    "source": "http://cgit.drupalcode.org/vardoc"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "assets": {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  },
  "replace": {
    "drupal/statistics": "*",
    "twbs/bootstrap": "*",
    "jquery/fancytree": "*",
    "fancytree/fancytree": "*",
    "npm-asset/ckeditor5": "*",
    "npm-asset/ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor5-core": "*",
    "npm-asset/ckeditor5-engine":"*",
    "npm-asset/ckeditor5-ui": "*",
    "npm-asset/ckeditor5-utils": "*",
    "npm-asset/ckeditor5-widget": "*",
    "npm-asset/ckeditor--ckeditor5": "*",
    "npm-asset/ckeditor--ckeditor5-dll-inline": "*",
    "npm-asset/ckeditor--ckeditor5-core": "*",
    "npm-asset/ckeditor--ckeditor5-engine":"*",
    "npm-asset/ckeditor--ckeditor5-ui": "*",
    "npm-asset/ckeditor--ckeditor5-utils": "*",
    "npm-asset/ckeditor--ckeditor5-widget": "*",
    "npm-asset/lodash-es": "*",
    "npm-asset/lodash.debounce": "*",
    "npm-asset/lodash.throttle": "*",
    "npm-asset/nouislider": "*",
    "npm-asset/rtseo.js": "*",
    "bower-asset/jquery": "*",
    "bower-asset/jquery-ui": "*"
  },
  "require": {
    "drupal/core": "~10.4.0",
    "vardot/varbase-patches": "~9.1.0 || ~9.2.0",
    "drupal/varbase_core": "~9.1.0",
    "drupal/varbase_api": "~9.1.0",
    "drupal/varbase_media": "~9.1.0",
    "drupal/varbase_editor": "~9.1.0 || ~9.2.0",
    "drupal/varbase_landing": "~9.1.0",
    "drupal/varbase_layout_builder": "~9 || ~10",
    "drupal/varbase_bootstrap_paragraphs": "~9.1.0",
    "drupal/varbase_heroslider_media": "~9.1.0",
    "drupal/varbase_carousels": "~9.1.0",
    "drupal/varbase_blog": "~9.1.0",
    "drupal/varbase_search": "~9.1.0",
    "drupal/varbase_seo": "~9.1.0",
    "drupal/varbase_auth": "~9.1.0",
    "drupal/varbase_total_control": "~9.1.0",
    "drupal/varbase_styleguide": "~9.1.0",
    "drupal/varbase_email": "~9.1.0",
    "drupal/varbase_workflow": "~2.1.0",
    "drupal/vartheme_bs4": "~9",
    "drupal/vartheme_claro": "~3",
    "drupal/varbase_faqs": "~9.1.0",
    "drupal/fontawesome": "~2",
    "drupal/votingapi": "~3",
    "drupal/votingapi_widgets": "~1",
    "drupal/flag": "~4",
    "drupal/sharethis": "~3",
    "drupal/menu_link_attributes": "~1",
    "drupal/book_tree_menu": "~2",
    "drupal/svg_image": "~3",
    "drupal/search_api_autocomplete": "~1",
    "bower-asset/objectfitpolyfill": "~2",
    "bower-asset/chartjs": "~4",
    "bower-asset/c3": "0.7.*",
    "bower-asset/d3": "~5",
    "bower-asset/jqueryui-touch-punch": "dev-master",
    "npm-asset/masonry-layout": "~4",
    "npm-asset/imagesloaded": "~4",
    "npm-asset/dropzone": "~5",
    "npm-asset/blazy": "~1",
    "npm-asset/slick-carousel": "~1",
    "npm-asset/ace-builds": "~1",
    "npm-asset/swagger-ui-dist": "~3",
    "npm-asset/northernco--ckeditor5-anchor-drupal": "^0.5.0",
    "npm-asset/ckeditor--ckeditor5-media-embed": "*",
    "npm-asset/jquery-bar-rating": "~1"
  },
  "require-dev": {
    "drupal/core-dev": "~10 || ~11",
    "drush/drush": "~12 || ~13"
  },
  "config": {
    "bin-dir": "bin/",
    "secure-http": false,
    "preferred-install": {
      "drupal/core": "dist"
    },
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "oomphinc/composer-installers-extender": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  },
  "autoload": {
    "psr-4": {
      "Vardoc\\composer\\": "src/composer"
    }
  },
  "scripts": {
    "pre-install-cmd": ["Vardoc\\composer\\ScriptHandler::checkComposerVersion"],
    "pre-update-cmd": ["Vardoc\\composer\\ScriptHandler::checkComposerVersion"],
    "post-install-cmd": [
      "Vardoc\\composer\\ScriptHandler::createRequiredFiles",
      "Vardoc\\composer\\ScriptHandler::removeGitDirectories"
    ],
    "post-update-cmd": [
      "Vardoc\\composer\\ScriptHandler::createRequiredFiles",
      "Vardoc\\composer\\ScriptHandler::removeGitDirectories"
    ],
    "post-drupal-scaffold-cmd": ["Vardoc\\composer\\ScriptHandler::postDrupalScaffoldProcedure"]
  }
}
